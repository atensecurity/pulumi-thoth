{
  "name": "pulumi-thoth-example-nodejs",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const src='node_modules/@atensec/pulumi-thoth/package.json';const dst='node_modules/@atensec/pulumi-thoth/bin/package.json';if(fs.existsSync(src)){fs.copyFileSync(src,dst);}\"",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@atensec/pulumi-thoth": "^0.1.12",
    "@pulumi/pulumi": "^3.170.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "typescript": "^5.9.3"
  }
}
